import SwiftUI

struct DashboardView: View {
 @StateObject private var api=APIService.shared; @State private var index="NIFTY 50"; private let indexes=["NIFTY 50","BANK NIFTY","SENSEX"]
 var body: some View { NavigationStack { ScrollView { VStack(spacing:14) { Picker("Index",selection:$index){ForEach(indexes,id:\.self){Text($0)}}.pickerStyle(.segmented); card("WHAT TO DO NOW"){Text(api.execution?.finalDecision?.decision ?? "NO CONFIRMATION / WAIT").font(.title3.bold());Text(api.execution?.finalDecision?.reasons?.first ?? "Loading analyzer stateâ€¦").font(.subheadline).foregroundStyle(.secondary)}; LazyVGrid(columns:[GridItem(.flexible()),GridItem(.flexible())]){tile("Direction",api.status?.interday?.direction);tile("Context",api.status?.interday?.context);tile("15M Confirmation",api.status?.interday?.stage8);tile("Fibonacci",api.status?.interday?.stage9)}; card("EXECUTION"){let e=api.execution?.execution;HStack{value("Entry",e?.entry);value("Stop Loss",e?.stop)};HStack{value("2R Target",e?.target2R);value("5M Trigger",e?.trigger)};Text(e?.detail?.first ?? "Execution state unavailable.").font(.caption).foregroundStyle(.secondary)}; StageAnalysisView(stages:api.stages?.stages); card("MTF / EXECUTION STATUS"){row("Weekly",api.execution?.mtf?.weekly?.direction);row("Daily",api.execution?.mtf?.daily?.direction);row("4H",api.execution?.mtf?.fourHour?.direction);row("1H",api.execution?.mtf?.oneHour?.direction);row("Tide",api.execution?.mtf?.tide);row("Wave",api.execution?.mtf?.wave);row("Alignment",api.execution?.mtf?.alignment)} }.padding() }.navigationTitle(index).refreshable{await api.refresh(index:index)}.task{await api.refresh(index:index)}.onChange(of:index){_,v in Task{await api.refresh(index:v)}}.toolbar{Button{Task{await api.refresh(index:index)}}label:{Image(systemName:"arrow.clockwise")}}.alert("API Connection",isPresented:Binding(get:{api.errorMessage != nil},set:{if !$0{api.errorMessage=nil}})){Button("OK",role:.cancel){}}message:{Text(api.errorMessage ?? "")} } }
 private func card<V:View>(_ t:String,@ViewBuilder _ c:()->V)->some View{VStack(alignment:.leading,spacing:10){Text(t).font(.headline);c()}.frame(maxWidth:.infinity,alignment:.leading).padding().background(.thinMaterial,in:RoundedRectangle(cornerRadius:16))}
 private func tile(_ t:String,_ v:String?)->some View{VStack(alignment:.leading){Text(t).font(.caption).foregroundStyle(.secondary);Text(v ?? "WAIT").bold()}.frame(maxWidth:.infinity,alignment:.leading).padding().background(.thinMaterial,in:RoundedRectangle(cornerRadius:14))}
 private func value(_ t:String,_ v:Double?)->some View{VStack(alignment:.leading){Text(t).font(.caption).foregroundStyle(.secondary);Text(v.map{String(format:"%.2f",$0)} ?? "â€”").bold()}.frame(maxWidth:.infinity,alignment:.leading)}
 private func row(_ t:String,_ v:String?)->some View{HStack{Text(t);Spacer();Text(v ?? "WAIT").bold()}}
}



